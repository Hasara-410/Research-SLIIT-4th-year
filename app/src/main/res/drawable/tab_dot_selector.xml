<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Selected Dot -->
    <item android:state_selected="true">
        <shape android:shape="ring">
            <size
                android:width="8dp"
                android:height="8dp"/>
            <solid android:color="@color/lanka_green_dark"/>
        </shape>
    </item>

    <!-- Unselected Dot -->
    <item>
        <shape android:shape="ring">
            <size
                android:width="6dp"
                android:height="6dp"/>
            <solid android:color="#D6D6D6"/>
        </shape>
    </item>

</selector>