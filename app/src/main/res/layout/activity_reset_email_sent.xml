<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#FFFFFF">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_lankalens_logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"/>

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LankaLens"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:textSize="22sp"
        app:layout_constraintTop_toBottomOf="@id/imgLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verify Code"
        android:textColor="#2E7D32"
        android:textStyle="bold"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvAppName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="14dp"/>

    <TextView
        android:id="@+id/tvSentMsg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="#777777"
        android:textSize="13sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"/>

    <!-- Fake OTP boxes for same UI look -->
    <LinearLayout
        android:id="@+id/otpRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/tvSentMsg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View style="@style/OtpBox"/>
        <View style="@style/OtpBox"/>
        <View style="@style/OtpBox"/>
        <View style="@style/OtpBox"/>
        <View style="@style/OtpBox"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerify"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="Verify"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:background="@drawable/btn_gradient"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        app:cornerRadius="26dp"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/otpRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvResendLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Didn't get the code? "
        android:textColor="#777777"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/btnVerify"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="14dp"/>

    <TextView
        android:id="@+id/tvResend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resend"
        android:textColor="#1C64F2"
        android:textStyle="bold"
        android:textSize="13sp"
        app:layout_constraintTop_toTopOf="@id/tvResendLine"
        app:layout_constraintStart_toEndOf="@id/tvResendLine"
        android:layout_marginStart="4dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>