<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#FFFFFF">

    <!-- Big Icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏛️"
        android:textSize="72sp"
        android:layout_marginBottom="24dp" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvWaitingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pre Quiz Complete!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Score Info -->
    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#E8F5E9">

        <TextView
            android:id="@+id/tvScoreInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Pre Quiz Score: 0 / 5"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:gravity="center"
            android:padding="20dp" />

    </androidx.cardview.widget.CardView>

    <!-- Message -->
    <TextView
        android:id="@+id/tvWaitingMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Great job! Now please go to the Projection Station to begin your heritage experience."
        android:textSize="16sp"
        android:textColor="#555555"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:layout_marginBottom="48dp" />

    <!-- Button -->
    <Button
        android:id="@+id/btnDone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="I'm at the Projection Station"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#4CAF50" />

</LinearLayout>